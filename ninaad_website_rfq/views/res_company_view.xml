<odoo>
    <record id="res_company_form_inherit_price_rfq" model="ir.ui.view">
        <field name="name">res.company.form.price.rfq</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
            	<page string="Configuration" name="configuration">
            		<group>
		                <field name="show_price"/>
		                <field name="allow_rfq"/>
		            </group>
	            </page>
            </xpath>

        </field>
    </record>
</odoo>